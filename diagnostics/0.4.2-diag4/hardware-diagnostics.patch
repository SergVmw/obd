index f17205d..ded41fe 100644
--- a/platformio.ini
+++ b/platformio.ini
@@ -53,3 +53,17 @@ build_flags =
     -D TFT_DC=11
     -D TFT_RST=12
     -D USE_HSPI_PORT=1
+
+; Temporary field-diagnostic OTA image. The normal release environment above
+; remains byte-reproducible as 0.4.2; diagnostic artifacts are kept outside
+; releases/ and never replace the published app/factory binaries.
+;
+; 0.4.2-diag4: passive CAN observation plus a controlled single-shot probe.
+; Every automatic 0x7DF request is disabled in this build; the only frame the
+; node may transmit is the operator-triggered 0x7E0 02 01 0C with ss=1.
+[env:esp32s3_n16r8_diag]
+extends = env:esp32s3_n16r8
+build_flags =
+    ${env:esp32s3_n16r8.build_flags}
+    -D H2G_HARDWARE_DIAGNOSTICS=1
+    -D H2G_FW_VERSION_OVERRIDE=\"0.4.2-diag4\"
