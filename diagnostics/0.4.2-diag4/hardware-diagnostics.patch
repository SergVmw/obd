diff --git a/include/obd_single_shot.h b/include/obd_single_shot.h
new file mode 100644
index 0000000..ce5e8be
--- /dev/null
+++ b/include/obd_single_shot.h
@@ -0,0 +1,206 @@
+#pragma once
+
+#ifdef H2G_HARDWARE_DIAGNOSTICS
+
+#include <Arduino.h>
+#include <esp_err.h>
+#include "driver/twai.h"
+
+// 0.4.2-diag4 — controlled physical TX probe for the unresolved H2 CAN fault.
+//
+// The release firmware transmits *functional* 0x7DF requests continuously. On
+// this vehicle another master (BRC S32 Evo is the primary candidate) already
+// uses 0x7DF, so two different payloads can start inside the same identifier
+// and normal arbitration cannot separate them. A data-field bit error plus the
+// hardware automatic retransmission is a plausible cause of the TX error
+// counter growth reported in FIELD_FINDINGS_2026-10-07.md.
+//
+// This probe is deliberately the opposite extreme:
+//
+//  * nothing is transmitted until the operator confirms a start in the web UI;
+//  * after boot / after service mode entry the node only observes passively;
+//  * the request uses the *physical* ISO-TP request address 0x7E0, so it can
+//    never collide with the 0x7DF functional requests of another requester;
+//  * the frame is sent with `ss = 1` (single shot): the TWAI controller does
+//    not retransmit it if it loses arbitration or the bus is disturbed, so one
+//    logical attempt can never become an unbounded burst of physical frames;
+//  * at most three attempts, each waiting 500 ms for the reply and each started
+//    2 s after the previous attempt failed;
+//  * the sequence stops immediately on the first valid `0x7E8 04 41 0C`
+//    reply (or on the first negative `0x7E8 03 7F 01 <NRC>` — a rejection also
+//    proves the engine ECU decoded our physical frame), and also stops early
+//    when the controller reports a physical bus error / TX failure;
+//  * every attempt stores, separately: TX result, TEC/REC, bus-error,
+//    arbitration-lost, TX-failed and RX-missed/overrun counters before and
+//    after, plus the received frame and its latency.
+//
+// Only one frame per attempt leaves the software queue, therefore the test can
+// prove the physical TX path while keeping the TX error counter from running
+// away.
+class ObdSingleShotTest {
+ public:
+  // Timing contract of the controlled repeat.
+  static constexpr uint8_t kMaxAttempts = 3;
+  static constexpr uint32_t kResponseTimeoutMs = 500;
+  static constexpr uint32_t kRetryDelayMs = 2000;
+  // Passive observation before a start is accepted, and the shorter refractory
+  // window that keeps the operator from hammering the bus with back-to-back
+  // tests.
+  static constexpr uint32_t kMinPassiveMs = 10000;
+  static constexpr uint32_t kPassiveRefractoryMs = 2000;
+  // Hard ceiling for a whole run: attempts + gaps + margins must fit inside it.
+  static constexpr uint32_t kWatchdogMs = 30000;
+  // Safety net: if the first attempt was never scheduled (for example because
+  // the pump is not wired into the loop), the run stops instead of leaving the
+  // web page in "выполняется" forever.
+  static constexpr uint32_t kStartWatchdogMs = 3000;
+  static constexpr uint32_t kRequestIdentifier = 0x7E0;
+  static constexpr uint32_t kResponseIdentifier = 0x7E8;
+  static constexpr uint8_t kPayloadLength = 8;
+  static const uint8_t kRequestPayload[kPayloadLength];
+
+  enum class Phase : uint8_t { Idle, AwaitingResponse, RetryDelay, Stopped };
+
+  enum class Outcome : uint8_t {
+    Pending,
+    ValidResponse,
+    NegativeResponse,
+    NoResponse,
+    TxFailed,
+    Aborted,
+  };
+
+  enum class StopReason : uint8_t {
+    None,
+    ValidResponse,
+    NegativeResponse,
+    AttemptsExhausted,
+    BusError,
+    TxFailure,
+    ControllerNotRunning,
+    Watchdog,
+    UserAbort,
+  };
+
+  // Snapshot of the TWAI controller counters and observed state.
+  struct Counters {
+    bool valid = false;
+    twai_state_t state = TWAI_STATE_STOPPED;
+    uint32_t txErrorCounter = 0;
+    uint32_t rxErrorCounter = 0;
+    uint32_t txFailed = 0;
+    uint32_t busErrors = 0;
+    uint32_t arbLost = 0;
+    uint32_t rxMissed = 0;
+    uint32_t rxOverrun = 0;
+    uint32_t txQueue = 0;
+    uint32_t rxQueue = 0;
+  };
+
+  struct Attempt {
+    uint8_t number = 0;
+    bool started = false;
+    uint32_t startedAtMs = 0;
+    uint32_t txAtMs = 0;
+    bool txAttempted = false;
+    esp_err_t txResult = ESP_OK;
+    Counters before{};
+    Counters after{};
+    Outcome outcome = Outcome::Pending;
+    uint32_t finishedAtMs = 0;
+    bool responseReceived = false;
+    bool responseValid = false;
+    uint32_t responseAtMs = 0;
+    uint8_t responseData[8]{};
+    uint8_t responseLength = 0;
+    float rpm = 0.0f;
+    uint32_t latencyMs = 0;
+  };
+
+  struct ObservedFrame {
+    bool seen = false;
+    uint32_t atMs = 0;
+    uint32_t identifier = 0;
+    uint8_t length = 0;
+    uint8_t data[8]{};
+  };
+
+  static Counters readCounters();
+  static const char* stateName(twai_state_t state);
+  static const char* outcomeName(Outcome outcome);
+  static const char* stopReasonName(StopReason reason);
+
+  // Passive observation is the default state. `begin()` starts the passive
+  // window; `tickPassive()` keeps it honest between tests.
+  void begin(uint32_t now);
+  void tickPassive(uint32_t now);
+
+  // Preconditions for a start, exposed so the UI can explain what is missing.
+  bool canStart(uint32_t now, const char*& blockedReason) const;
+  // Starts a run. `errorName` receives a static reason when the start is
+  // refused, so the HTTP response can say exactly why.
+  bool start(uint32_t now, const char*& errorName);
+  bool abort(uint32_t now);
+
+  // Per-loop advance. Transmits at most one frame per attempt; never transmits
+  // when the test is idle. Returns true when a frame was handed to the TWAI
+  // driver and `transmitted` is filled with the frame for mirroring into the
+  // CAN monitor.
+  bool pump(uint32_t now, twai_message_t& transmitted);
+
+  // Called from the RX path for every frame accepted from the controller.
+  // Returns true when the frame was consumed as the reply to the open attempt.
+  bool observe(const twai_message_t& message, uint32_t now);
+
+  bool running() const { return running_; }
+  Phase phase() const { return phase_; }
+  bool everStarted() const { return attemptsStarted_ != 0; }
+  uint32_t passiveElapsedMs(uint32_t now) const { return now - passiveSince_; }
+  uint32_t testElapsedMs(uint32_t now) const {
+    return running_ ? now - startedAtMs_ : 0;
+  }
+  uint8_t attemptsStarted() const { return attemptsStarted_; }
+  uint8_t retriesStarted() const { return retries_; }
+  uint8_t attemptCount() const { return attemptCount_; }
+  const Attempt& attempt(uint8_t index) const { return attempts_[index]; }
+  StopReason stopReason() const { return stopReason_; }
+  bool stopped() const { return everStarted() && !running_; }
+  const char* lastError() const { return lastError_; }
+  uint32_t testStartedAtMs() const { return startedAtMs_; }
+  uint32_t currentTxAtMs() const { return currentTxAtMs_; }
+  const Counters& passiveBaseline() const { return passiveBaseline_; }
+  const Counters& testBaseline() const { return testBaseline_; }
+  const Counters& lastCounters() const { return lastCounters_; }
+  const ObservedFrame& lateResponse() const { return lateResponse_; }
+  uint32_t lateResponseCount() const { return lateResponseCount_; }
+
+ private:
+  void startAttempt(uint32_t now);
+  bool transmitAttempt(uint32_t now, twai_message_t& transmitted);
+  bool afterAttemptFailed(uint32_t now);
+  void finishAttempt(uint32_t now, Outcome outcome);
+  void stop(uint32_t now, StopReason reason);
+  bool attemptBudgetLeft() const { return attemptsStarted_ < kMaxAttempts; }
+  void noteLateResponse(const twai_message_t& message, uint32_t now);
+  static bool isReplyToPendingRequest(const twai_message_t& message);
+
+  bool running_ = false;
+  Phase phase_ = Phase::Idle;
+  uint32_t passiveSince_ = 0;
+  uint32_t startedAtMs_ = 0;
+  uint32_t currentTxAtMs_ = 0;
+  uint32_t retryAtMs_ = 0;
+  uint8_t attemptsStarted_ = 0;
+  uint8_t retries_ = 0;
+  uint8_t attemptCount_ = 0;
+  Attempt attempts_[kMaxAttempts]{};
+  Counters passiveBaseline_{};
+  Counters testBaseline_{};
+  Counters lastCounters_{};
+  StopReason stopReason_ = StopReason::None;
+  const char* lastError_ = "";
+  ObservedFrame lateResponse_{};
+  uint32_t lateResponseCount_ = 0;
+};
+
+#endif  // H2G_HARDWARE_DIAGNOSTICS
