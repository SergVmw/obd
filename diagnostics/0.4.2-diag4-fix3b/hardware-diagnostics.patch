+  counters.rxOverrun = status.rx_overrun_count;
+  counters.txQueue = status.msgs_to_tx;
+  counters.rxQueue = status.msgs_to_rx;
+  return counters;
+}
+
+const char* ObdSingleShotTest::stateName(twai_state_t state) {
+  switch (state) {
+    case TWAI_STATE_STOPPED: return "stopped";
+    case TWAI_STATE_RUNNING: return "running";
+    case TWAI_STATE_BUS_OFF: return "bus_off";
+    case TWAI_STATE_RECOVERING: return "recovering";
+    default: return "unknown";
+  }
+}
+
+const char* ObdSingleShotTest::outcomeName(Outcome outcome) {
+  switch (outcome) {
+    case Outcome::ValidResponse: return "valid_response";
+    case Outcome::NegativeResponse: return "negative_response";
+    case Outcome::NoResponse: return "no_response";
+    case Outcome::TxFailed: return "tx_failed";
+    case Outcome::Aborted: return "aborted";
+    case Outcome::Pending:
+    default: return "pending";
+  }
+}
+
+const char* ObdSingleShotTest::stopReasonName(StopReason reason) {
+  switch (reason) {
+    case StopReason::ValidResponse: return "valid_response";
+    case StopReason::NegativeResponse: return "negative_response";
+    case StopReason::AttemptsExhausted: return "attempts_exhausted";
+    case StopReason::BusError: return "bus_error";
+    case StopReason::TxFailure: return "tx_failure";
+    case StopReason::ControllerNotRunning: return "controller_not_running";
+    case StopReason::Watchdog: return "watchdog";
+    case StopReason::UserAbort: return "user_abort";
+    case StopReason::None:
+    default: return "none";
+  }
+}
+
+void ObdSingleShotTest::begin(uint32_t now) {
+  running_ = false;
+  phase_ = Phase::Idle;
+  passiveSince_ = now;
+  startedAtMs_ = 0;
+  currentTxAtMs_ = 0;
+  retryAtMs_ = 0;
+  attemptsStarted_ = 0;
+  retries_ = 0;
+  attemptCount_ = 0;
+  for (auto& attempt : attempts_) attempt = Attempt{};
+  passiveBaseline_ = readCounters();
+  testBaseline_ = passiveBaseline_;
+  lastCounters_ = passiveBaseline_;
+  stopReason_ = StopReason::None;
+  lastError_ = "";
+  lateResponse_ = ObservedFrame{};
+  lateResponseCount_ = 0;
+}
+
+void ObdSingleShotTest::tickPassive(uint32_t now) {
+  if (running_) {
+    if (attemptCount_ == 0 && now - startedAtMs_ >= kStartWatchdogMs) {
+      lastError_ = "probe_not_scheduled";
+      stop(now, StopReason::Watchdog);
+    }
+    return;
+  }
+  lastCounters_ = readCounters();
+}
+
+bool ObdSingleShotTest::canStart(uint32_t now, const char*& blockedReason) const {
+  blockedReason = "";
+  if (running_) {
+    blockedReason = "test_running";
+    return false;
+  }
+  const uint32_t elapsed = now - passiveSince_;
+  if (elapsed < kMinPassiveMs) {
+    blockedReason = "passive_window";
+    return false;
+  }
+  const Counters counters = readCounters();
+  if (!counters.valid) {
+    blockedReason = "twai_status_unavailable";
+    return false;
+  }
+  if (counters.state != TWAI_STATE_RUNNING) {
+    blockedReason = "controller_not_running";
+    return false;
+  }
+  if (counters.txQueue != 0) {
+    // A frame from an earlier activity is still queued; transmitting on top of
+    // it would make the attempt accounting ambiguous.
+    blockedReason = "tx_queue_not_empty";
+    return false;
+  }
+  return true;
+}
+
+bool ObdSingleShotTest::start(uint32_t now, const char*& errorName) {
+  errorName = "";
+  const char* blocked = "";
+  if (!canStart(now, blocked)) {
+    errorName = blocked;
+    return false;
+  }
+
+  // A new run replaces the previous record set. Old records stay visible until
+  // then, so the operator can photograph or copy them.
+  attemptsStarted_ = 0;
+  retries_ = 0;
+  attemptCount_ = 0;
+  for (auto& attempt : attempts_) attempt = Attempt{};
+  lateResponse_ = ObservedFrame{};
+  lateResponseCount_ = 0;
+  stopReason_ = StopReason::None;
+  lastError_ = "";
+
+  running_ = true;
+  startedAtMs_ = now;
+  currentTxAtMs_ = 0;
+  testBaseline_ = readCounters();
+  lastCounters_ = testBaseline_;
+  // The first attempt fires on the next pump(), so the transmitted frame is
+  // mirrored into the CAN monitor by the caller exactly like any other TX.
+  phase_ = Phase::RetryDelay;
+  retryAtMs_ = now;
+  return true;
+}
+
+bool ObdSingleShotTest::abort(uint32_t now) {
+  if (!running_) return false;
+  finishAttempt(now, Outcome::Aborted);
+  stop(now, StopReason::UserAbort);
+  return true;
+}
+
+bool ObdSingleShotTest::pump(uint32_t now, twai_message_t& transmitted) {
+  if (!running_) return false;
+
+  const Counters counters = readCounters();
+  if (counters.valid) lastCounters_ = counters;
+
+  if (now - startedAtMs_ >= kWatchdogMs) {
+    finishAttempt(now, Outcome::Aborted);
+    lastError_ = "watchdog";
+    stop(now, StopReason::Watchdog);
+    return false;
+  }
+
+  // BUS_OFF / RECOVERING / STOPPED: a frame handed to such a controller cannot
+  // complete a clean transmission, so the run stops instead of retrying.
+  if (counters.valid && counters.state != TWAI_STATE_RUNNING) {
+    finishAttempt(now, Outcome::Aborted);
+    lastError_ = stateName(counters.state);
+    stop(now, StopReason::ControllerNotRunning);
+    return false;
+  }
+
+  if (phase_ == Phase::AwaitingResponse) {
+    const Attempt& attempt = attempts_[attemptCount_ - 1];
+    if (counters.valid && attempt.before.valid) {
+      const bool busError = counters.busErrors > attempt.before.busErrors;
+      const bool txFailed = counters.txFailed > attempt.before.txFailed;
+      const bool tecRaised = counters.txErrorCounter >
+                             attempt.before.txErrorCounter;
+      const bool arbitrationLost = counters.arbLost > attempt.before.arbLost;
+      if (busError || txFailed || tecRaised || arbitrationLost) {
+        lastError_ = busError ? "bus_error" :
+                     (txFailed ? "tx_failed" :
+                      (tecRaised ? "tec_increased" : "arbitration_lost"));
+        finishAttempt(now, Outcome::TxFailed);
+        stop(now, busError || tecRaised ? StopReason::BusError
+                                        : StopReason::TxFailure);
+        return false;
+      }
+    }
+    if (now - currentTxAtMs_ >= kResponseTimeoutMs) {
+      finishAttempt(now, Outcome::NoResponse);
+      afterAttemptFailed(now);
+    }
+    return false;
+  }
+
+  if (phase_ == Phase::RetryDelay &&
+      static_cast<int32_t>(now - retryAtMs_) >= 0) {
+    if (!attemptBudgetLeft()) {
+      stop(now, StopReason::AttemptsExhausted);
+      return false;
+    }
+    startAttempt(now);
+    return transmitAttempt(now, transmitted);
+  }
+  return false;
+}
+
+void ObdSingleShotTest::noteTxSuccessAlert() {
+  if (running_ && phase_ == Phase::AwaitingResponse && attemptCount_ != 0) {
+    attempts_[attemptCount_ - 1].txSuccessAlert = true;
+  }
+}
+
+bool ObdSingleShotTest::observe(const twai_message_t& message, uint32_t now) {
+  if (!running_) return false;
+  if (!isReplyToPendingRequest(message)) return false;
+
+  if (phase_ != Phase::AwaitingResponse || attemptCount_ == 0) {
+    // A 0x7E8 41 0C frame outside our own window is not an answer to this
+    // attempt (the LPG controller polls the same engine ECU on 0x7DF). It is
+    // recorded as a late/unattributed reply and does not influence the result.
+    noteLateResponse(message, now);
+    return false;
+  }
+
+  Attempt& attempt = attempts_[attemptCount_ - 1];
+  attempt.responseReceived = true;
+  attempt.responseAtMs = now;
+  attempt.latencyMs = now - attempt.txAtMs;
+  const uint8_t length =
+      message.data_length_code > 8 ? 8 : message.data_length_code;
+  attempt.responseLength = length;
+  memcpy(attempt.responseData, message.data, length);
+  const bool positive =
+      message.data[1] == 0x41 && message.data_length_code >= 5;
+  attempt.responseValid = positive;
+  if (positive) {
+    attempt.rpm = ((static_cast<uint16_t>(message.data[3]) << 8) |
+                   message.data[4]) /
+                  4.0f;
+  }
+
+  finishAttempt(now,
+                positive ? Outcome::ValidResponse : Outcome::NegativeResponse);
+  stop(now, positive ? StopReason::ValidResponse
+                     : StopReason::NegativeResponse);
+  return true;
+}
+
+bool ObdSingleShotTest::isReplyToPendingRequest(
+    const twai_message_t& message) {
+  if (message.extd || message.rtr) return false;
+  if (message.identifier != kResponseIdentifier) return false;
+  if (message.data_length_code < 3) return false;
+  // Positive reply: `41 0C` (Mode 01, PID 0C) as the first two data bytes.
+  if (message.data[1] == 0x41) return message.data[2] == 0x0C;
+  // Negative reply: SAE J1979 / ISO 15765 `7F <service> <NRC>` — the requested
+  // PID is *not* echoed, so an answer to our own Mode 01 request is
+  // `03 7F 01 <NRC>`. Demanding data[2] == 0x0C here (the previous rule) turned
+  // every real rejection into "no response" and burned the whole attempt
+  // budget without ever reporting why.
+  if (message.data[1] == 0x7F) return message.data[2] == 0x01;
+  return false;
+}
+
+void ObdSingleShotTest::startAttempt(uint32_t now) {
+  Attempt& attempt = attempts_[attemptCount_];
+  attempt = Attempt{};
+  attempt.number = static_cast<uint8_t>(attemptsStarted_ + 1);
+  attempt.started = true;
+  attempt.startedAtMs = now;
+  attempt.before = readCounters();
+  ++attemptsStarted_;
+  ++attemptCount_;
+  if (attempt.number > 1) ++retries_;
+  phase_ = Phase::AwaitingResponse;
+  currentTxAtMs_ = now;
+}
+
+bool ObdSingleShotTest::transmitAttempt(uint32_t now,
+                                        twai_message_t& transmitted) {
+  Attempt& attempt = attempts_[attemptCount_ - 1];
+  twai_message_t message{};
+  message.identifier = kRequestIdentifier;
+  message.extd = 0;
+  message.rtr = 0;
+  message.data_length_code = kPayloadLength;
+  memcpy(message.data, kRequestPayload, kPayloadLength);
+  // Single shot transmission: the controller sends this frame exactly once and
+  // never retransmits it after a lost arbitration or a bus error.
+  message.ss = 1;
+
+  attempt.txAttempted = true;
+  attempt.txAtMs = now;
+  attempt.txResult = twai_transmit(&message, pdMS_TO_TICKS(20));
+  if (attempt.txResult != ESP_OK) {
+    // The frame never reached the controller, so no reply can be expected.
+    lastError_ = esp_err_to_name(attempt.txResult);
+    finishAttempt(now, Outcome::TxFailed);
+    afterAttemptFailed(now);
+    return false;
+  }
+
+  transmitted = message;
+  phase_ = Phase::AwaitingResponse;
+  return true;
+}
+
+bool ObdSingleShotTest::afterAttemptFailed(uint32_t now) {
+  const Attempt& attempt = attempts_[attemptCount_ - 1];
+  const Counters& before = attempt.before;
+  const Counters& after = attempt.after;
+  if (before.valid && after.valid) {
+    const bool busErrorDelta =
+        static_cast<int32_t>(after.busErrors - before.busErrors) > 0;
+    const bool txFailedDelta =
+        static_cast<int32_t>(after.txFailed - before.txFailed) > 0;
+    const bool tecIncrease =
+        static_cast<int32_t>(after.txErrorCounter - before.txErrorCounter) > 0;
+    const bool arbitrationLost =
+        static_cast<int32_t>(after.arbLost - before.arbLost) > 0;
+    if (busErrorDelta || txFailedDelta || tecIncrease || arbitrationLost) {
+      // A physical bus error or a failed frame is not a candidate for a blind
+      // repeat: the run stops here and the attempt record carries the evidence.
+      stop(now, busErrorDelta || tecIncrease ? StopReason::BusError
+                                             : StopReason::TxFailure);
+      return false;
+    }
+  }
+
+  if (!attemptBudgetLeft()) {
+    stop(now, StopReason::AttemptsExhausted);
+    return false;
+  }
+
+  phase_ = Phase::RetryDelay;
+  retryAtMs_ = now + kRetryDelayMs;
+  return true;
+}
+
+void ObdSingleShotTest::finishAttempt(uint32_t now, Outcome outcome) {
+  if (attemptCount_ == 0) return;
+  Attempt& attempt = attempts_[attemptCount_ - 1];
+  if (attempt.outcome != Outcome::Pending) return;
+  attempt.outcome = outcome;
+  attempt.finishedAtMs = now;
+  attempt.after = readCounters();
+  if (!attempt.after.valid) attempt.after = attempt.before;
+  lastCounters_ = attempt.after;
+}
+
+void ObdSingleShotTest::stop(uint32_t now, StopReason reason) {
+  running_ = false;
+  phase_ = Phase::Stopped;
+  stopReason_ = reason;
+  currentTxAtMs_ = 0;
+  retryAtMs_ = 0;
+  lastCounters_ = readCounters();
+  // Re-arm the passive window. A run that already waited through the full
+  // passive window does not have to wait all ten seconds again, but the bus
+  // still gets a short observation gap before the next start is accepted.
+  passiveSince_ = now - (kMinPassiveMs - kPassiveRefractoryMs);
+}
+
+void ObdSingleShotTest::noteLateResponse(const twai_message_t& message,
+                                         uint32_t now) {
+  ++lateResponseCount_;
+  lateResponse_.seen = true;
+  lateResponse_.atMs = now;
+  lateResponse_.identifier = message.identifier;
+  const uint8_t length =
+      message.data_length_code > 8 ? 8 : message.data_length_code;
+  lateResponse_.length = length;
+  memcpy(lateResponse_.data, message.data, length);
+}
