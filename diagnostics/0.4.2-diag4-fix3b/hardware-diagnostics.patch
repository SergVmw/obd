+void formatFrameBytes(char* output, size_t capacity, const uint8_t* data,
+                      uint8_t length) {
+  size_t offset = 0;
+  if (capacity == 0) return;
+  output[0] = '\0';
+  for (uint8_t i = 0; i < length && offset + 3 < capacity; ++i) {
+    offset += snprintf(output + offset, capacity - offset,
+                       i == 0 ? "%02X" : " %02X", data[i]);
+  }
+}
+
+int32_t counterDelta(uint32_t after, uint32_t before) {
+  return static_cast<int32_t>(after - before);
+}
+
+void addTwaiCounters(JsonObject output,
+                     const ObdSingleShotTest::Counters& counters) {
+  output["available"] = counters.valid;
+  output["state"] = counters.valid
+                        ? ObdSingleShotTest::stateName(counters.state)
+                        : "unavailable";
+  output["tec"] = counters.txErrorCounter;
+  output["rec"] = counters.rxErrorCounter;
+  output["txFailed"] = counters.txFailed;
+  output["busErrors"] = counters.busErrors;
+  output["arbLost"] = counters.arbLost;
+  output["rxMissed"] = counters.rxMissed;
+  output["rxOverrun"] = counters.rxOverrun;
+  output["txQueue"] = counters.txQueue;
+  output["rxQueue"] = counters.rxQueue;
+}
+
+void addAttributedFrame(JsonObject output, const uint8_t* data, uint32_t length,
+                        uint32_t identifier) {
+  char id[12];
+  snprintf(id, sizeof(id), "0x%03lX", static_cast<unsigned long>(identifier));
+  output["id"] = id;
+  output["dlc"] = length;
+  char bytes[24]{};
+  formatFrameBytes(bytes, sizeof(bytes), data,
+                   static_cast<uint8_t>(length > 8 ? 8 : length));
+  output["data"] = bytes;
+}
+
+void addDigitalPin(JsonObject parent, const char* key, uint8_t pin,
+                   const char* direction, int rawLevel) {
+  JsonObject value = parent[key].to<JsonObject>();
+  value["pin"] = pin;
+  value["direction"] = direction;
+  value["rawLevel"] = rawLevel;
+  value["voltageHint"] = rawLevel == HIGH ? "HIGH (~3.3 V)" : "LOW (~0 V)";
+}
