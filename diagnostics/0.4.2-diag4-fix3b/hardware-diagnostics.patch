+  bool testInstalled = setupResult == ESP_OK;
+  if (testInstalled) setupResult = twai_start();
+  if (setupResult != ESP_OK) {
+    result.failure = "self_test_driver_setup_failed";
+  } else {
+    result.failure = "self_test_no_echo";
+    constexpr uint8_t kFrames = 3;
+    for (uint8_t i = 0; i < kFrames; ++i) {
+      twai_message_t tx{};
+      tx.identifier = 0x555;
+      tx.extd = 0;
+      tx.rtr = 0;
+      tx.ss = 1;
+      tx.self = 1;
+      tx.data_length_code = 2;
+      tx.data[0] = 0xA5;
+      tx.data[1] = static_cast<uint8_t>(0x30 + i);
