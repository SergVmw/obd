+  twai["driverReady"] = telemetry_.canDriverReady;
+  twai["installed"] = obdClient_.diagnosticInstalled();
+  twai["paused"] = obdClient_.diagnosticPaused();
+  twai["recovering"] = obdClient_.diagnosticRecovering();
+  twai["bitrate"] = 500000;
+  twai["mode"] = "normal";
+  twai_status_info_t status{};
+  const esp_err_t statusResult = telemetry_.canDriverReady
+                                     ? twai_get_status_info(&status)
+                                     : ESP_ERR_INVALID_STATE;
+  twai["statusAvailable"] = statusResult == ESP_OK;
+  twai["statusError"] = statusResult == ESP_OK
+                              ? "ESP_OK"
+                              : esp_err_to_name(statusResult);
+  if (statusResult == ESP_OK) {
+    twai["state"] = twaiStateName(status.state);
+    twai["txQueue"] = status.msgs_to_tx;
+    twai["rxQueue"] = status.msgs_to_rx;
+    twai["txErrorCounter"] = status.tx_error_counter;
+    twai["rxErrorCounter"] = status.rx_error_counter;
+    twai["txFailedCount"] = status.tx_failed_count;
+    twai["rxMissedCount"] = status.rx_missed_count;
+    twai["rxOverrunCount"] = status.rx_overrun_count;
+    twai["arbitrationLostCount"] = status.arb_lost_count;
+    twai["busErrorCount"] = status.bus_error_count;
+  } else {
+    twai["state"] = "unavailable";
+  }
+
+  CanFrameSnapshot frames[CanMonitor::kCapacity]{};
+  uint32_t totalFrames = 0;
+  uint32_t evictions = 0;
+  const size_t frameCount = canMonitor_.snapshot(
+      frames, CanMonitor::kCapacity, totalFrames, evictions);
+  uint32_t retainedTxFrames = 0;
+  uint32_t retainedRxFrames = 0;
+  uint32_t externalFunctionalRequestFrames = 0;
+  uint32_t rawObdResponseFrames = 0;
+  const CanFrameSnapshot* latestTx = nullptr;
+  const CanFrameSnapshot* latestRx = nullptr;
+  uint32_t latestTxAge = UINT32_MAX;
+  uint32_t latestRxAge = UINT32_MAX;
+  for (size_t i = 0; i < frameCount; ++i) {
+    const CanFrameSnapshot& frame = frames[i];
+    const uint32_t age = now - frame.lastSeenAt;
+    if (frame.transmitted) {
+      retainedTxFrames += frame.count;
+      if (age < latestTxAge) {
+        latestTx = &frame;
+        latestTxAge = age;
+      }
+    } else {
+      retainedRxFrames += frame.count;
+      if (!frame.extended && !frame.remote && frame.identifier == 0x7DF) {
+        externalFunctionalRequestFrames += frame.count;
+      }
+      if (!frame.extended && !frame.remote && frame.identifier >= 0x7E8 &&
+          frame.identifier <= 0x7EF) {
+        rawObdResponseFrames += frame.count;
+      }
+      if (age < latestRxAge) {
+        latestRx = &frame;
+        latestRxAge = age;
+      }
+    }
+  }
+
+  JsonObject can = doc["can"].to<JsonObject>();
+  can["totalObservedFrames"] = totalFrames;
+  can["retainedTxFrames"] = retainedTxFrames;
+  can["retainedRxFrames"] = retainedRxFrames;
+  can["externalFunctionalRequestFrames"] = externalFunctionalRequestFrames;
+  can["rawObdResponseFrames"] = rawObdResponseFrames;
+  can["retainedKeys"] = frameCount;
+  can["evictions"] = evictions;
+  can["telemetryErrorCount"] = telemetry_.canErrorCount;
+
+  const auto addFrame = [now](JsonObject output,
+                              const CanFrameSnapshot* frame) {
+    if (!frame) {
+      output["seen"] = false;
+      return;
+    }
+    output["seen"] = true;
+    char id[12];
+    snprintf(id, sizeof(id), frame->extended ? "0x%08lX" : "0x%03lX",
+             static_cast<unsigned long>(frame->identifier));
+    output["id"] = id;
+    output["extended"] = frame->extended;
+    output["remote"] = frame->remote;
+    output["dlc"] = frame->length;
+    output["count"] = frame->count;
+    output["ageMs"] = now - frame->lastSeenAt;
+    char data[24]{};
+    size_t offset = 0;
+    for (uint8_t i = 0; i < frame->length && offset + 3 < sizeof(data); ++i) {
+      offset += snprintf(data + offset, sizeof(data) - offset,
+                         i == 0 ? "%02X" : " %02X", frame->data[i]);
+    }
+    output["data"] = data;
+  };
+  addFrame(can["latestTx"].to<JsonObject>(), latestTx);
+  addFrame(can["latestRx"].to<JsonObject>(), latestRx);
+
+  JsonObject obd = doc["obd"].to<JsonObject>();
+  obd["readOnlyPollingActive"] = !obdClient_.diagnosticPaused();
+  // In fix3b the meaningful state is the software TX gate: the client loop
+  // still runs (RX, counters, probe pump) while every automatic request is
+  // disabled. Report that combination as the intended state, not as an error.
+  obd["softwareTxPaused"] = obdClient_.diagnosticTxPaused();
+  obd["automaticRequests"] =
+      obdClient_.diagnosticTxPaused() ? "disabled" : "active";
+  obd["waiting"] = obdClient_.diagnosticWaiting();
+  obd["pendingRequest"] = obdClient_.diagnosticPendingRequestName();
+  obd["pendingPid"] = obdClient_.diagnosticPendingPid();
+  obd["discoveryDone"] = obdClient_.diagnosticDiscoveryDone();
+  obd["discoveryIndex"] = obdClient_.diagnosticDiscoveryIndex();
+  obd["pollCursor"] = obdClient_.diagnosticPollCursor();
+  obd["lastRequestAgeMs"] = obdClient_.diagnosticLastRequestAt() != 0
+                                  ? static_cast<int64_t>(
+                                        now - obdClient_.diagnosticLastRequestAt())
+                                  : -1;
+  obd["pendingRequestAgeMs"] =
+      obdClient_.diagnosticWaiting() &&
+              obdClient_.diagnosticRequestSentAt() != 0
+          ? static_cast<int64_t>(
+                now - obdClient_.diagnosticRequestSentAt())
+          : -1;
+  obd["responses"] = telemetry_.obdResponseCount;
+  obd["timeouts"] = telemetry_.obdTimeoutCount;
+  obd["lastResponseAgeMs"] = telemetry_.lastObdResponseAt != 0
+                                   ? static_cast<int64_t>(
+                                         now - telemetry_.lastObdResponseAt)
+                                   : -1;
+  obd["engineEcuLocked"] = diagnostics.engineEcuLocked;
+  char engineEcu[10]{};
+  if (diagnostics.engineResponseId != 0) {
+    snprintf(engineEcu, sizeof(engineEcu), "0x%03X",
+             diagnostics.engineResponseId);
+  }
+  obd["engineEcuId"] = engineEcu;
+  obd["diagnosticOperation"] =
+      ObdDiagnostics::operationName(diagnostics.operation);
+  obd["lastError"] = diagnostics.lastError;
+
+  JsonArray observations = doc["observations"].to<JsonArray>();
+  if (!config.lpgEnabled) {
+    observations.add("LPG is disabled in configuration");
+  } else if (!lpgElectricalActive) {
+    observations.add(config.lpgActiveLow
+                         ? "GPIO5 is HIGH; active-low LPG input is inactive"
+                         : "GPIO5 is LOW; active-high LPG input is inactive");
+  } else {
+    observations.add("GPIO5 electrical level currently indicates LPG ON");
+  }
+  if (!telemetry_.canDriverReady || statusResult != ESP_OK) {
+    observations.add("TWAI driver/status is unavailable");
+  } else if (status.state == TWAI_STATE_BUS_OFF) {
+    observations.add("TWAI is BUS-OFF: check CANH/CANL, ground, bitrate and termination");
+  } else if (retainedTxFrames > 0 && retainedRxFrames == 0) {
+    observations.add("CAN TX exists but no RX was observed: check transceiver wiring, common ground, CANH/CANL and termination");
+  } else if (rawObdResponseFrames > 0 &&
+             telemetry_.obdResponseCount == 0) {
+    observations.add("Raw 0x7E8-0x7EF replies exist, but no PID 0C engine-ECU lock was accepted; compare request and response PIDs");
+  } else if (retainedRxFrames > 0 && telemetry_.obdResponseCount == 0) {
+    observations.add("CAN RX exists but no valid OBD response was accepted");
+  }
+  if (externalFunctionalRequestFrames > 0) {
+    observations.add("RX 0x7DF requests detected: another OBD requester is active (for example ELM327, LPG controller or telematics)");
+  }
+  if (statusResult == ESP_OK &&
+      (status.tx_failed_count != 0 || status.bus_error_count != 0)) {
+    observations.add("TWAI reports transmit/bus errors; inspect the physical CAN layer");
+  }
+  if (digitalRead(Pins::CanRx) == LOW && retainedRxFrames == 0) {
+    observations.add("GPIO17/CRX is LOW without decoded RX frames; inspect SN65HVD230 power and wiring");
+  }
+  if (obdClient_.diagnosticSelfTestPassed() &&
+      obdClient_.diagnosticTxPaused() &&
+      digitalRead(Pins::CanTx) == LOW) {
+    observations.add("GPIO16/TWAI_TX digitalRead is LOW despite the successful bench self-test; this readback is not treated as proof of a stuck pin. Verify GPIO16/TXD with a scope when available; on-car probe still requires self-test PASS and explicit confirmation");
+  }
+
+  const ObdSingleShotTest& singleShot = obdClient_.diagnosticSingleShotTest();
+  JsonObject test = doc["singleShot"].to<JsonObject>();
+  // Probe revision marker. The first diag4 image (probe "0.4.2-diag4") never
+  // scheduled an attempt because the pump was wired into the wrong loop branch;
+  // "fix2" = fix1 (attempts are scheduled from the passive branch) + negative
+  // replies matched as `7F 01 <NRC>` instead of requiring a PID echo.
+  test["probe"] = "0.4.2-diag4-fix3b";
+  test["automaticFunctionalRequests"] = "disabled";
+  test["softwareTxPaused"] = obdClient_.diagnosticTxPaused();
+  test["watchdogMs"] = ObdSingleShotTest::kWatchdogMs;
+  JsonObject request = test["request"].to<JsonObject>();
+  request["identifier"] = "0x7E0";
+  request["data"] = "02 01 0C 00 00 00 00 00";
+  request["txMode"] = "single_shot_ss1";
+  request["responseIdentifier"] = "0x7E8";
+  request["expected"] = "41 0C";
+  request["timeoutMs"] = ObdSingleShotTest::kResponseTimeoutMs;
+  request["retryDelayMs"] = ObdSingleShotTest::kRetryDelayMs;
+  request["maxAttempts"] = ObdSingleShotTest::kMaxAttempts;
+
+  JsonObject passive = test["passive"].to<JsonObject>();
+  const uint32_t passiveElapsed = singleShot.passiveElapsedMs(now);
+  passive["elapsedMs"] = passiveElapsed;
+  passive["requiredMs"] = ObdSingleShotTest::kMinPassiveMs;
+  passive["ready"] = passiveElapsed >= ObdSingleShotTest::kMinPassiveMs;
+  addTwaiCounters(passive["baseline"].to<JsonObject>(),
+                  singleShot.passiveBaseline());
+
+  test["running"] = singleShot.running();
+  test["phase"] = testPhaseName(singleShot.phase());
+  test["elapsedMs"] = singleShot.testElapsedMs(now);
+  test["attemptsStarted"] = singleShot.attemptsStarted();
+  test["retries"] = singleShot.retriesStarted();
+  test["stopReason"] =
+      ObdSingleShotTest::stopReasonName(singleShot.stopReason());
+  test["lastError"] = singleShot.lastError();
+  test["benchSelfTestPassed"] = obdClient_.diagnosticSelfTestPassed();
+  test["vehicleProbeLockedOut"] =
+      obdClient_.diagnosticVehicleProbeLockedOut();
+  const char* blockedReason = "";
+  bool canStartProbe = singleShot.canStart(now, blockedReason);
+  if (canStartProbe && !obdClient_.diagnosticSelfTestPassed()) {
+    canStartProbe = false;
+    blockedReason = "bench_self_test_required";
+  }
+  if (canStartProbe && obdClient_.diagnosticVehicleProbeLockedOut()) {
+    canStartProbe = false;
+    blockedReason = "vehicle_probe_locked_out_after_bus_error";
+  }
+  test["canStart"] = canStartProbe;
+  test["blockedReason"] = blockedReason;
+  test["lateResponseCount"] = singleShot.lateResponseCount();
+  if (singleShot.lateResponse().seen) {
+    JsonObject late = test["lateResponse"].to<JsonObject>();
+    addAttributedFrame(late, singleShot.lateResponse().data,
+                       singleShot.lateResponse().length,
+                       singleShot.lateResponse().identifier);
+    late["ageMs"] = now - singleShot.lateResponse().atMs;
+    late["attributedToTest"] = false;
+  }
+  addTwaiCounters(test["testBaseline"].to<JsonObject>(),
+                  singleShot.testBaseline());
+  addTwaiCounters(test["lastCounters"].to<JsonObject>(),
+                  singleShot.lastCounters());
+
+  JsonArray attempts = test["attempts"].to<JsonArray>();
+  for (uint8_t i = 0; i < singleShot.attemptCount(); ++i) {
+    const ObdSingleShotTest::Attempt& attempt = singleShot.attempt(i);
+    JsonObject row = attempts.add<JsonObject>();
+    row["number"] = attempt.number;
+    row["outcome"] = ObdSingleShotTest::outcomeName(attempt.outcome);
+    row["txAttempted"] = attempt.txAttempted;
+    row["txDriverAccepted"] = attempt.txAttempted && attempt.txResult == ESP_OK;
+    row["txSuccess"] = attempt.txSuccessAlert;
+    row["txSuccessAlert"] = attempt.txSuccessAlert;
+    row["txResult"] = esp_err_to_name(attempt.txResult);
+    row["startedAgoMs"] = static_cast<int64_t>(now - attempt.startedAtMs);
+    row["tecBefore"] = attempt.before.txErrorCounter;
+    row["tecAfter"] = attempt.after.txErrorCounter;
+    row["tecDelta"] =
+        counterDelta(attempt.after.txErrorCounter, attempt.before.txErrorCounter);
+    row["recBefore"] = attempt.before.rxErrorCounter;
+    row["recAfter"] = attempt.after.rxErrorCounter;
+    row["recDelta"] =
+        counterDelta(attempt.after.rxErrorCounter, attempt.before.rxErrorCounter);
+    row["busErrorDelta"] =
+        counterDelta(attempt.after.busErrors, attempt.before.busErrors);
+    row["arbLostDelta"] =
+        counterDelta(attempt.after.arbLost, attempt.before.arbLost);
+    row["txFailedDelta"] =
+        counterDelta(attempt.after.txFailed, attempt.before.txFailed);
+    row["rxMissedDelta"] =
+        counterDelta(attempt.after.rxMissed, attempt.before.rxMissed);
+    row["rxOverrunDelta"] =
+        counterDelta(attempt.after.rxOverrun, attempt.before.rxOverrun);
+    row["stateBefore"] = attempt.before.valid
+                             ? ObdSingleShotTest::stateName(attempt.before.state)
+                             : "unavailable";
+    row["stateAfter"] = attempt.after.valid
+                            ? ObdSingleShotTest::stateName(attempt.after.state)
+                            : "unavailable";
+    addTwaiCounters(row["before"].to<JsonObject>(), attempt.before);
+    addTwaiCounters(row["after"].to<JsonObject>(), attempt.after);
+    if (attempt.txAttempted) {
+      row["txAgoMs"] = static_cast<int64_t>(now - attempt.txAtMs);
+    }
+    if (attempt.responseReceived) {
+      JsonObject response = row["response"].to<JsonObject>();
+      addAttributedFrame(response, attempt.responseData,
+                         attempt.responseLength,
+                         ObdSingleShotTest::kResponseIdentifier);
+      response["valid"] = attempt.responseValid;
+      response["latencyMs"] = attempt.latencyMs;
+      response["ageMs"] = static_cast<int64_t>(now - attempt.responseAtMs);
+      if (attempt.responseValid) response["rpm"] = attempt.rpm;
+    }
+  }
+
+  const uint32_t rawAlerts = obdClient_.diagnosticAlertFlags();
+  JsonArray alertFlags = test["alertFlags"].to<JsonArray>();
+  if (rawAlerts & TWAI_ALERT_TX_FAILED) alertFlags.add("tx_failed");
+  if (rawAlerts & TWAI_ALERT_ARB_LOST) alertFlags.add("arbitration_lost");
+  if (rawAlerts & TWAI_ALERT_BUS_ERROR) alertFlags.add("bus_error");
+  if (rawAlerts & TWAI_ALERT_BUS_OFF) alertFlags.add("bus_off");
+  if (rawAlerts & TWAI_ALERT_BUS_RECOVERED) alertFlags.add("bus_recovered");
+  if (rawAlerts & TWAI_ALERT_RX_QUEUE_FULL) alertFlags.add("rx_queue_full");
+  test["alertFlagsRaw"] = rawAlerts;
+
+  if (singleShot.stopped()) {
+    switch (singleShot.stopReason()) {
+      case ObdSingleShotTest::StopReason::ValidResponse:
+        observations.add(
+            "Controlled single-shot probe received a valid 0x7E8 41 0C reply: "
+            "the physical TX path works and 0x7DF contention was the real risk");
+        break;
+      case ObdSingleShotTest::StopReason::BusError:
+      case ObdSingleShotTest::StopReason::TxFailure:
+        observations.add(
+            "Controlled single-shot probe hit a bus error or TX failure: "
+            "inspect CTX/GPIO16, the transceiver driver, power, ground and "
+            "termination before any further transmission");
+        break;
+      case ObdSingleShotTest::StopReason::AttemptsExhausted:
+        observations.add(
+            "The one-shot OBD request received no ECU reply, but no bus-error "
+            "or TEC increase was recorded; a bus-level TX_SUCCESS confirms "
+            "the frame was acknowledged on the vehicle network");
+        break;
+      case ObdSingleShotTest::StopReason::ControllerNotRunning:
+        observations.add(
+            "Controlled single-shot probe stopped because the TWAI controller "
+            "was not running any more");
+        break;
+      case ObdSingleShotTest::StopReason::Watchdog:
+        observations.add(
+            "Controlled single-shot probe was stopped by its watchdog; make "
+            "sure the running image matches this page (probe id) before "
+            "repeating the test");
+        break;
+      default:
+        break;
+    }
+  }
+  if (rawAlerts & TWAI_ALERT_ARB_LOST) {
+    observations.add(
+        "TWAI reported an arbitration loss alert; counter deltas per attempt "
+        "show whether it happened during the probe window");
+  }
+
+  String output;
+  output.reserve(12288);
+  serializeJson(doc, output);
+  server_.sendHeader("Cache-Control", "no-store");
+  server_.send(200, "application/json", output);
+}
+
+void ServicePortal::startSingleShotTest() {
+  touch();
+  const uint32_t now = millis();
+  ObdSingleShotTest& test = obdClient_.diagnosticSingleShotTest();
+  if (server_.arg("confirm") != "on-car-readonly") {
+    server_.send(422, "application/json",
+                 "{\"ok\":false,\"error\":\"explicit one-frame on-car confirmation required\"}");
+    return;
+  }
+  if (!requireAction("single-shot-start", lastSingleShotAt_, 2000)) return;
+  if (!obdClient_.diagnosticSelfTestPassed()) {
+    server_.send(412, "application/json",
+                 "{\"ok\":false,\"reason\":\"bench_self_test_required\"}");
+    return;
+  }
+  if (obdClient_.diagnosticVehicleProbeLockedOut()) {
+    server_.send(423, "application/json",
+                 "{\"ok\":false,\"reason\":\"vehicle_probe_locked_out_after_bus_error\"}");
+    return;
+  }
+
+  JsonDocument doc;
+  const char* errorName = "";
+  const bool accepted = obdClient_.diagnosticTxPaused() &&
+                        test.start(now, errorName);
+  if (!accepted) {
+    doc["ok"] = false;
+    doc["error"] = "single-shot test not started";
+    doc["reason"] = obdClient_.diagnosticTxPaused() ? errorName
+                                                    : "tx_path_not_paused";
+    doc["passiveElapsedMs"] = test.passiveElapsedMs(now);
+    doc["passiveRequiredMs"] = ObdSingleShotTest::kMinPassiveMs;
+    doc["testRunning"] = test.running();
+    String output;
+    serializeJson(doc, output);
+    server_.send(409, "application/json", output);
+    return;
+  }
+
+  doc["ok"] = true;
+  doc["accepted"] = true;
+  doc["maxAttempts"] = ObdSingleShotTest::kMaxAttempts;
+  doc["timeoutMs"] = ObdSingleShotTest::kResponseTimeoutMs;
+  doc["retryDelayMs"] = 0;
+  doc["request"] = "0x7E0 02 01 0C 00 00 00 00 00 (one single-shot; no retry)";
+  String output;
+  serializeJson(doc, output);
+  server_.send(202, "application/json", output);
+}
+
+void ServicePortal::abortSingleShotTest() {
+  touch();
+  const bool aborted = obdClient_.diagnosticSingleShotTest().abort(millis());
+  server_.send(200, "application/json",
+               aborted ? "{\"ok\":true,\"aborted\":true}"
+                       : "{\"ok\":true,\"aborted\":false}");
+}
+
+void ServicePortal::runTwaiTransceiverSelfTest() {
+  touch();
+  if (server_.arg("confirm") != "isolated-bench") {
+    server_.send(422, "application/json",
+                 "{\"ok\":false,\"error\":\"explicit isolated bench confirmation required\"}");
+    return;
+  }
+  if (!requireAction("twai-self-test", lastTwaiSelfTestAt_, 10000)) return;
+
+  ObdClient::DiagnosticSelfTestResult result{};
+  const bool passed = obdClient_.diagnosticRunTransceiverSelfTest(result);
+  JsonDocument doc;
+  doc["ok"] = passed;
+  doc["test"] = "TWAI_MODE_NO_ACK + self reception, 500 kbit/s";
+  doc["canHCanLMustBe"] = "physically disconnected from vehicle";
+  doc["attempted"] = result.attempted;
+  doc["received"] = result.received;
+  doc["passed"] = result.passed;
+  doc["normalDriverRestored"] = result.driverRestored;
+  doc["txPadBefore"] = result.txLevelBefore;
+  doc["txPadAfter"] = result.txLevelAfter;
+  doc["rxPadAfter"] = result.rxLevelAfter;
+  doc["failure"] = result.failure;
+  String output;
+  serializeJson(doc, output);
+  server_.send(passed ? 200 : 500, "application/json", output);
+}
